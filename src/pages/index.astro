---
const progress = 7;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#e3dad5" />
    <meta name="description" content="Sergio Pezo is building." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Sergio Pezo is building</title>
  </head>
  <body>
    <main>
      <section class="building" aria-labelledby="name">
        <div class="copy">
          <h1 id="name">Sergio Pezo</h1>
          <p>is building</p>
          <div
            class="progress"
            role="progressbar"
            aria-label="Portfolio progress"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow={progress}
          >
            <span style={`--progress: ${progress}%`}></span>
          </div>
        </div>

        <img src="/photo.jpeg" alt="Sergio Pezo" width="360" height="411" />
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #e3dad5;
    color: #2d2520;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    min-width: 320px;
    min-height: 100vh;
    background:
      radial-gradient(circle at 12% 10%, rgba(70, 112, 142, 0.2), transparent 34rem),
      linear-gradient(145deg, #e3dad5 0%, #e3cbaf 100%);
  }

  main {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: clamp(1.25rem, 5vw, 4rem);
  }

  .building {
    width: min(100%, 920px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 360px);
    align-items: center;
    gap: clamp(2rem, 8vw, 6rem);
  }

  h1 {
    max-width: 7ch;
    margin: 0;
    color: #46708e;
    font-size: clamp(4rem, 12vw, 8.5rem);
    font-weight: 750;
    letter-spacing: -0.075em;
    line-height: 0.82;
  }

  p {
    margin: 1.35rem 0 2.25rem;
    color: #6f5542;
    font-size: clamp(1.15rem, 2.5vw, 1.6rem);
    letter-spacing: 0.04em;
  }

  .progress {
    width: min(100%, 24rem);
    height: 0.38rem;
    overflow: hidden;
    background: rgba(45, 37, 32, 0.16);
  }

  .progress span {
    display: block;
    width: var(--progress);
    height: 100%;
    background: #46708e;
  }

  img {
    width: 100%;
    aspect-ratio: 360 / 411;
    object-fit: cover;
    filter: saturate(0.78) contrast(1.04);
    border: 1px solid rgba(111, 85, 66, 0.32);
    box-shadow: 1.25rem 1.25rem 0 rgba(70, 112, 142, 0.14);
  }

  @media (max-width: 650px) {
    .building { grid-template-columns: 1fr; gap: 2.5rem; }
    h1 { max-width: none; font-size: clamp(3.75rem, 19vw, 6rem); }
    img { width: min(78vw, 19rem); justify-self: end; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto !important; }
  }
</style>
